variable "vpc_id" { type = string }
variable "sg_name" { type = string }
variable "sg_description" { type = string }

variable "ingress_rules" {
  type = list(object({
    description = string
    from_port   = number
    to_port     = number
    protocol    = string
    cidr_blocks = list(string)
  }))
